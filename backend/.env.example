# ── ATS Resume Score Checker Configuration ──
# Copy this file to .env and fill in your values.

# App
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ats_resume_checker

# Security - CRITICAL: change this in production
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File handling
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: Scoring weights (each is a number; must total 100)
WEIGHT_KEYWORD_MATCH=30
WEIGHT_TECHNICAL_SKILL=25
WEIGHT_EXPERIENCE=20
WEIGHT_STRUCTURE=10
WEIGHT_EDUCATION=5
WEIGHT_FORMATTING=10
