# ── ATS Resume Score Checker Configuration ──
# Copy this file to .env and fill in your values.
# All values shown here are safe defaults for LOCAL DEVELOPMENT ONLY.
# Production values MUST be provided via the hosting platform's environment
# variables (Render, Docker, etc.) — never commit a real .env.

# ── App ──
# Environment: development, staging, or production
ENVIRONMENT=development
DEBUG=true
# Port the backend listens on. Render injects $PORT at runtime;
# the start command uses --port $PORT so this is local-dev only.
PORT=8000

# ── Database ──
# PostgreSQL (recommended for production):
#   postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
#   Example: postgresql+asyncpg://atsuser:changeme@db.example.com:5432/ats_resume_checker
# SQLite (local dev only — NOT for production):
# DATABASE_URL=sqlite+aiosqlite:///./ats_resume_checker.db

# ── Security ──
# CRITICAL: Generate a strong secret for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters in production.
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_MIN_LENGTH=8

# ── File handling ──
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# ── CORS ──
# Comma-separated list of allowed origins (no trailing slash).
# Production MUST list your real frontend domain(s), e.g.:
#   ALLOWED_ORIGINS=https://ats-resume-checker.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── NLP Models ──
# Sentence Transformer model name (all-MiniLM-L6-v2 is the default).
# NOTE: The app gracefully falls back to TF-IDF if the model cannot load,
# so this is safe to leave at the default on low-memory hosts.
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# ── Scoring Weights (must sum to 100) ──
WEIGHT_KEYWORD_MATCH=30
WEIGHT_TECHNICAL_SKILL=25
WEIGHT_EXPERIENCE=20
WEIGHT_STRUCTURE=10
WEIGHT_EDUCATION=5
WEIGHT_FORMATTING=10

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_ANALYSIS=20

# ── Logging ──
LOG_LEVEL=INFO

# ── Reports ──
REPORT_DIR=./reports